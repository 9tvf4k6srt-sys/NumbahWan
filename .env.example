# Copy to .env.local. Every variable is optional for local development:
# with nothing set, the app runs against an embedded PGLite database and a
# dev-mode auth user, so `npm install && npm run dev` just works.

# Postgres connection string (e.g. Neon). When set, `npm run build` applies
# migrations/ to it and the server uses it instead of PGLite.
DATABASE_URL=

# Better Auth. Required in production; a stable secret is derived in preview.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Enable the real sign-in flow in the client (otherwise a dev user is used).
VITE_AUTH_ENABLED=

# Public hostname, used to build absolute og:image URLs for link previews.
VITE_PUBLIC_HOSTNAME=
